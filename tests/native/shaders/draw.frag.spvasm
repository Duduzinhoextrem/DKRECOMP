; Original synthetic shader: binding 1 multiplies the sample at binding 2.
; Both sources deliberately use set 0, as the Maxwell translator does; the backend assigns sets by stage.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %uv %color
OpExecutionMode %main OriginUpperLeft
OpDecorate %uv Location 0
OpDecorate %color Location 0
OpDecorate %Color Block
OpMemberDecorate %Color 0 Offset 0
OpDecorate %multiply DescriptorSet 0
OpDecorate %multiply Binding 1
OpDecorate %texture DescriptorSet 0
OpDecorate %texture Binding 2
%void = OpTypeVoid
%fn = OpTypeFunction %void
%float = OpTypeFloat 32
%v2 = OpTypeVector %float 2
%v4 = OpTypeVector %float 4
%int = OpTypeInt 32 1
%zero = OpConstant %int 0
%Color = OpTypeStruct %v4
%p_color = OpTypePointer Uniform %Color
%p_uniform_v4 = OpTypePointer Uniform %v4
%image = OpTypeImage %float 2D 0 0 0 1 Unknown
%sampled = OpTypeSampledImage %image
%p_texture = OpTypePointer UniformConstant %sampled
%p_in_v2 = OpTypePointer Input %v2
%p_out_v4 = OpTypePointer Output %v4
%multiply = OpVariable %p_color Uniform
%texture = OpVariable %p_texture UniformConstant
%uv = OpVariable %p_in_v2 Input
%color = OpVariable %p_out_v4 Output
%main = OpFunction %void None %fn
%entry = OpLabel
%coord = OpLoad %v2 %uv
%sampler = OpLoad %sampled %texture
%texel = OpImageSampleImplicitLod %v4 %sampler %coord
%cp = OpAccessChain %p_uniform_v4 %multiply %zero
%c = OpLoad %v4 %cp
%result = OpFMul %v4 %texel %c
OpStore %color %result
OpReturn
OpFunctionEnd
